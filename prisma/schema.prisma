generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model UserAccount {
  id         String      @id @default(cuid())
  email      String      @unique
  name       String?
  categoryRulesVersion Int @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  spaces   Space[]
  loginCodes LoginCode[]
  sessions   Session[]
  categoryMatches CategoryMatch[]
}

enum TransactionCategory {
  shopping
  food_groceries
  bars_restaurants
  leisure_entertainment
  housing_public_services
  transport_car
  atm
  income
  family_friends
  insurance
  pets
  savings_investments
  health_personal_care
  travel
  subscriptions_digital_services
  donations
  uncategorized
}

enum TransactionCategorySource {
  manual
  learned
  rule
  fallback
  backfill
}

enum SpaceType {
  credit_card
}

enum CreditCardPaymentTiming {
  same_month
  previous_month
}

model Space {
  id        String   @id @default(cuid())
  userAccountId    String
  userAccount      UserAccount     @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  name      String
  main      Boolean?
  type      SpaceType?
  paymentDueDay Int?
  paymentTiming CreditCardPaymentTiming?
  periodEndDay Int?
  isArchived Boolean @default(false)
  currentMonthTransactionCount Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members SpaceMember[]
  transactions   Transaction[]
  transferTransactions Transaction[] @relation("TransactionTransferSpace")

  @@unique([userAccountId, name])
  @@index([userAccountId])
}

model Transaction {
  id          String    @id @default(cuid())
  type        String    // "income" or "expense"
  spaceId   String
  space     Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  transferSpaceId String?
  transferSpace Space? @relation("TransactionTransferSpace", fields: [transferSpaceId], references: [id], onDelete: SetNull)
  splitParticipantIds String?
  description String
  amount      Float
  category TransactionCategory @default(uncategorized)
  categorySource TransactionCategorySource @default(fallback)
  beginDate   DateTime
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([spaceId])
  @@index([transferSpaceId])
  @@index([beginDate])
}

enum CategoryRuleMatchMode {
  exact
  phrase
  all
}

model CategoryDefault {
  id String @id @default(cuid())
  pattern String
  transactionType String
  matchMode CategoryRuleMatchMode @default(phrase)
  category TransactionCategory
  priority Int @default(0)
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pattern, transactionType, matchMode])
  @@index([enabled, priority])
}

model CategoryMatch {
  id String @id @default(cuid())
  userAccountId String
  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  normalizedDescription String
  matchMode CategoryRuleMatchMode @default(exact)
  transactionType String
  category TransactionCategory
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userAccountId, normalizedDescription, transactionType, matchMode], map: "CategoryMatch_account_description_type_mode_key")
}

model LoginCode {
  id         String   @id @default(cuid())
  userAccountId     String
  userAccount       UserAccount     @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([userAccountId])
  @@index([email])
  @@index([expiresAt])
}

model Session {
  id               String   @id @default(cuid())
  userAccountId           String
  userAccount             UserAccount     @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  sessionTokenHash String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([userAccountId])
  @@index([expiresAt])
}

model SpaceMember {
  id String @id @default(cuid())
  spaceId String
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name String
  removedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId])
}
